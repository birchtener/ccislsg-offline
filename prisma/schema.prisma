generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// +++++++++++++++++++++++++++
// AUDIT LOGS
// +++++++++++++++++++++++++++

enum AuditType {
  success
  info
  error
  warn
}

enum AuditCategory {
  authentication
  inventory
  payments
  attendance
  clearance
  announcements
  events
  admin
}

model AuditLog {
  id         String        @id @default(uuid())
  user_id    String
  log        String
  type       AuditType
  category   AuditCategory
  created_at DateTime      @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([category])
  @@index([created_at])
  @@map("audit_logs")
}

// +++++++++++++++++++++++++++
// CONTENT MANAGEMENT (Announcements, Projects, Events)
// +++++++++++++++++++++++++++

enum PostType {
  announcement
  event
  project
}

enum ProjectStatus {
  planned
  ongoing
  completed // if completed, will be shown to the "Achievements" section
}

enum GridType {
  AUTO
  GRID_2X1
  GRID_2X2
  GRID_3X1
  SINGLE
}

model BulletinBoard {
  id         String   @id @default(uuid())
  title      String?  @db.VarChar(100)
  content    String?  @db.VarChar(300)
  post_id    String?  @unique
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  post Post? @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("bulletin_boards")
}

model Post {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  content    String   @db.Text
  type       PostType
  published  Boolean  @default(false)
  grid_type  GridType @default(AUTO)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String

  event_date     DateTime?
  project_status ProjectStatus?
  bulletin_board BulletinBoard?

  author User        @relation(fields: [created_by], references: [id])
  images PostImage[]

  @@map("posts")
}

model PostImage {
  id         String   @id @default(uuid())
  post_id    String
  image_url  String
  is_primary Boolean  @default(false) // for thumbnails/cover photos
  order      Int      @default(0)
  created_at DateTime @default(now())

  post Post @relation(fields: [post_id], references: [id])

  @@unique([post_id, order])
  @@map("post_images")
}

// +++++++++++++++++++++++++++
// USERS & AUTHENTICATION
// +++++++++++++++++++++++++++

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   Boolean   @map("email_verified")
  role_id         String
  name            String
  first_name      String
  last_name       String
  username        String    @unique
  displayUsername String?   @map("display_username")
  image           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  role                Role                @relation(fields: [role_id], references: [id])
  audit_logs          AuditLog[]
  approver            InventoryBorrow[]
  items               InventoryItem[]
  transactions        Transaction[]
  attendance          Attendance[]
  events              AttendanceEvents[]
  clearance           ClearanceList[]
  rendered_clearance  RenderedClearance[]
  posts               Post[]
  sessions            Session[]
  accounts            Account[]
  stock_logs          InventoryStockLog[]
  fee_item_stock_logs FeeItemStockLog[]
  created_fee_items   FeeItem[]
  lost_found_items    LostFoundItem[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

// +++++++++++++++++++++++++++
// ROLES AND PERMISSIONS
// +++++++++++++++++++++++++++

model Role {
  id   String @id @default(uuid())
  name String @unique

  users            User[]
  role_permissions RolePermission[]

  @@map("roles")
}

model PermissionCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text

  permissions Permission[]

  @@map("permission_categories")
}

model Permission {
  id          String @id @default(uuid())
  name        String @unique
  category_id String

  category         PermissionCategory @relation(fields: [category_id], references: [id])
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

// +++++++++++++++++++++++++++
// INVENTORY
// +++++++++++++++++++++++++++

enum CategoryType {
  PROPERTY
  EQUIPMENT
  SUPPLIES
}

enum AssetItemStatus {
  AVAILABLE
  BORROWED
  MAINTENANCE
  LOST
  DISPOSED
}

model InventoryCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  inventory_items InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id              String       @id @default(uuid())
  name            String
  description     String?
  type            CategoryType @default(SUPPLIES)
  item_code       String?      @map("item_code")
  serial_number   String?      @map("serial_number")
  source_of_fund  String?      @map("source_of_fund")
  quantity        Int          @default(0)
  unit            String       @default("pcs")
  category_id     String
  created_by      String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  date_purchased  DateTime?    @map("date_purchased")
  is_disposed     Boolean      @default(false) @map("is_disposed")
  disposed_at     DateTime?    @map("disposed_at")
  disposal_reason String?      @map("disposal_reason")
  disposed_by     String?      @map("disposed_by")

  category     InventoryCategory @relation(fields: [category_id], references: [id])
  created_user User              @relation(fields: [created_by], references: [id])

  assets     InventoryAsset[]
  borrows    InventoryBorrow[]
  stock_logs InventoryStockLog[]

  @@index([category_id])
  @@index([type])
  @@index([created_at])
  @@map("inventory_items")
}

model InventoryAsset {
  id            String          @id @default(uuid())
  item_id       String
  asset_tag     String          @unique
  qr_code       String          @unique
  serial_number String?         @map("serial_number")
  status        AssetItemStatus @default(AVAILABLE)
  condition     String          @default("Used - Good")
  created_at    DateTime        @default(now())

  item    InventoryItem     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  borrows InventoryBorrow[]

  @@index([item_id])
  @@index([status])
  @@map("inventory_assets")
}

model InventoryBorrow {
  id       String  @id @default(uuid())
  item_id  String
  asset_id String?
  quantity Int     @default(1)

  student_id  String?
  borrowed_by String?
  approved_by String

  borrowed_at DateTime  @default(now())
  due_date    DateTime?
  returned_at DateTime?
  remarks     String?

  item     InventoryItem       @relation(fields: [item_id], references: [id])
  asset    InventoryAsset?     @relation(fields: [asset_id], references: [id])
  student  Student?            @relation(fields: [student_id], references: [id])
  borrower InventoryBorrowers? @relation(fields: [borrowed_by], references: [id])
  approver User                @relation(fields: [approved_by], references: [id])

  @@index([item_id])
  @@index([student_id])
  @@index([borrowed_by])
  @@index([returned_at])
  @@index([borrowed_at])
  @@map("inventory_borrows")
}

model InventoryBorrowers {
  id             String   @id @default(uuid())
  first_name     String
  last_name      String
  contact_number String
  email          String?
  remarks        String?
  created_at     DateTime @default(now())

  borrows InventoryBorrow[]

  @@map("inventory_borrowers")
}

enum StockActionType {
  ADD
  REDUCE
  ADJUSTMENT
}

model InventoryStockLog {
  id                String          @id @default(uuid())
  item_id           String
  actor_id          String
  action_type       StockActionType
  quantity_change   Int
  previous_quantity Int
  new_quantity      Int
  reason            String?
  created_at        DateTime        @default(now())

  item  InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  actor User          @relation(fields: [actor_id], references: [id])

  @@index([item_id])
  @@index([created_at])
  @@map("inventory_stock_logs")
}

// +++++++++++++++++++++++++++
// LOST AND FOUND
// +++++++++++++++++++++++++++

enum LostFoundStatus {
  UNCLAIMED
  CLAIMED
}

model LostFoundItem {
  id             String          @id @default(uuid())
  title          String
  description    String?         @db.Text
  location_found String?
  date_found     DateTime        @default(now())
  status         LostFoundStatus @default(UNCLAIMED)
  claimed_by     String?
  claimed_at     DateTime?
  remarks        String?
  created_by     String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  created_user User             @relation(fields: [created_by], references: [id])
  images       LostFoundImage[]

  @@map("lost_found_items")
}

model LostFoundImage {
  id         String   @id @default(uuid())
  item_id    String
  image_url  String
  public_id  String?
  order      Int      @default(0)
  created_at DateTime @default(now())

  item LostFoundItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id])
  @@map("lost_found_images")
}

// +++++++++++++++++++++++++++
// STUDENTS
// +++++++++++++++++++++++++++

enum Program {
  BSIT
  BSIS
  BSCS
}

model Student {
  id         String   @id @default(uuid())
  student_id String   @unique
  first_name String
  last_name  String
  year       Int
  program    Program
  created_at DateTime @default(now())

  transactions Transaction[]
  attendance   Attendance[]
  clearances   Clearance[]
  borrows      InventoryBorrow[]

  @@index([last_name])
  @@index([program])
  @@index([year])
  @@map("students")
}

// +++++++++++++++++++++++++++
// PAYMENTS/FISCAL
// +++++++++++++++++++++++++++

enum FeeType {
  cf
  mf
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

model FeeItem {
  id           String   @id @default(uuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  type         FeeType
  quantity     Int      @default(0)
  has_variants Boolean  @default(false)
  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  created_user      User?             @relation(fields: [created_by], references: [id])
  variants          FeeItemVariant[]
  stock_logs        FeeItemStockLog[]
  transaction_items TransactionItem[]

  @@map("fee_items")
}

model FeeItemVariant {
  id         String   @id @default(uuid())
  item_id    String
  name       String
  quantity   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  item              FeeItem           @relation(fields: [item_id], references: [id], onDelete: Cascade)
  stock_logs        FeeItemStockLog[]
  transaction_items TransactionItem[]

  @@index([item_id])
  @@map("fee_item_variants")
}

model FeeItemStockLog {
  id                String          @id @default(uuid())
  item_id           String
  variant_id        String?
  actor_id          String
  action_type       StockActionType
  quantity_change   Int
  previous_quantity Int
  new_quantity      Int
  reason            String?
  created_at        DateTime        @default(now())

  item    FeeItem         @relation(fields: [item_id], references: [id], onDelete: Cascade)
  variant FeeItemVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  actor   User            @relation(fields: [actor_id], references: [id])

  @@index([item_id])
  @@index([created_at])
  @@map("fee_item_stock_logs")
}

model Transaction {
  id             String            @id @default(uuid())
  af_number      String
  student_id     String
  staff_id       String
  total_amount   Decimal           @db.Decimal(12, 2)
  payment_method String            @default("CASH")
  status         TransactionStatus @default(COMPLETED)
  remarks        String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  student Student           @relation(fields: [student_id], references: [id])
  staff   User              @relation(fields: [staff_id], references: [id])
  items   TransactionItem[]

  @@index([student_id])
  @@index([staff_id])
  @@index([created_at])
  @@map("transactions")
}

model TransactionItem {
  id             String  @id @default(uuid())
  transaction_id String
  item_id        String
  variant_id     String?
  quantity       Int     @default(1)
  unit_price     Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  transaction Transaction     @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  item        FeeItem         @relation(fields: [item_id], references: [id])
  variant     FeeItemVariant? @relation(fields: [variant_id], references: [id])

  @@index([transaction_id])
  @@index([item_id])
  @@map("transaction_items")
}

// +++++++++++++++++++++++++++
// ATTENDANCE
// +++++++++++++++++++++++++++

enum AttendanceType {
  in
  out
}

model Attendance {
  id         String         @id @default(uuid())
  student_id String
  event_id   String
  staff_id   String
  type       AttendanceType
  time       DateTime       @default(now())

  staff   User             @relation(fields: [staff_id], references: [id])
  student Student          @relation(fields: [student_id], references: [id])
  event   AttendanceEvents @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@index([student_id])
  @@index([time])
  @@map("attendance")
}

model AttendanceEvents {
  id                String   @id @default(uuid())
  name              String
  start_date        DateTime
  end_date          DateTime
  requires_time_out Boolean  @default(true)
  created_by        String
  created_at        DateTime @default(now())

  user       User         @relation(fields: [created_by], references: [id])
  attendance Attendance[]

  @@map("attendance_events")
}

// +++++++++++++++++++++++++++
// CLEARANCE
// +++++++++++++++++++++++++++

model Clearance {
  id           String @id @default(uuid())
  student_id   String
  clearance_id String

  student            Student             @relation(fields: [student_id], references: [id])
  clearance          ClearanceList       @relation(fields: [clearance_id], references: [id])
  rendered_clearance RenderedClearance[]

  @@map("clearances")
}

model ClearanceList {
  id         String   @id @default(uuid())
  name       String
  req_hrs    Int
  created_by String
  created_at DateTime @default(now())

  user       User        @relation(fields: [created_by], references: [id])
  clearances Clearance[]

  @@map("clearance_lists")
}

model RenderedClearance {
  id           String         @id @default(uuid())
  clearance_id String
  staff_id     String
  type         AttendanceType
  time         DateTime       @default(now())

  clearance Clearance @relation(fields: [clearance_id], references: [id])
  staff     User      @relation(fields: [staff_id], references: [id])

  @@map("rendered_clearances")
}
